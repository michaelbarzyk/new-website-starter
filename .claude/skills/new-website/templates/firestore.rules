rules_version = '2';

// ===============================================================
// Data model (keep this in sync as collections are added)
// ===============================================================
//
// Collection: admins
// Document ID: Firebase Auth uid. Existence of the doc grants admin.
// Fields: role: string ("admin"), informational only; rules check existence.
// Created automatically the first time an owner (see ownerEmails) signs in; otherwise by hand
// in the Firebase console.
//
// Everything else is denied until a rule below opens it on purpose.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Verified Google emails that may make themselves admin by signing in. Edit to add owners.
    function ownerEmails() {
      return ['__OWNER_EMAIL__'];
    }

    // A signed-in user can read only their own admins doc (to learn whether they are admin).
    // An owner can create their own doc once; nobody else can write admins from the app.
    match /admins/{uid} {
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email in ownerEmails();
      allow list, update, delete: if false;
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
